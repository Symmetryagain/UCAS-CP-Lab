@func %iremoveElement ( %ainums , %in , %ival ) 
@var %ii
assign %ii = 0
label while_start
@var %btmp1
LT %btmp1 %ii %in
branch while_end %btmp1
@var %btmp2
EQ %btmp2 %ainums[%ii] %ival
Not %btmp2 %btmp2
branch if_end %btmp2
@var %itmp3
Sub %itmp3 %in 1
assign %ainums[%ii] %ainums[%itmp3]
Sub %in %in 1
branch else_end true
label if_end
Add %ii %ii 1
label else_end
branch while_start true
label while_end
return %in
@endfunc 

@func main ( )
@var %ires
@array %aia 10
assign %aia[0] 3
assign %aia[1] 3
assign %aia[2] 9
assign %aia[3] 0
assign %aia[4] 0
assign %aia[5] 1
assign %aia[6] 1
assign %aia[7] 5
assign %aia[8] 7
assign %aia[9] 8
assign %ires 10
@var %ival
assign %ival 3
call %ires %iremoveElement ( %aia , %ires , %ival )
return %ires
@endfunc