@func %dget_pi ( %dn )
@var %di
@var %ds
assign %di 1.0
assign %ds 0.0
@var %dx
@var %btmp2
label while_start
LE %btmp2 %di %dn
Not %btmp2 %btmp2
branch while_end %btmp2
Div %dx %di %dn
@var %dtmp3
Mul %dtmp3 %dx %dx
Add %dtmp3 %dtmp3 1.0
Div %dtmp3 1.0 %dtmp3
Add %ds %ds %dtmp3
Add %di 1.0 %di
retire %dtmp3
branch while_start true
label while_end
@var %dtmp4
Mul %dtmp4 4.0 %ds
Div %dtmp4 %dtmp4 %dn
return %dtmp4
@endfunc

@func main ( )
@var %dn
@var %dpi
call %dn get_double ( )
@var %btmp1
GT %btmp1 %dn 0.0
Not %btmp1 %btmp1
branch if_end %btmp1
call %dpi %dget_pi ( %dn )
call void print_double ( %dpi )
return 0
branch else_end true
label if_end
return 1
label else_end
@endfunc
