@func %ifactorial ( %in )
@var %btmp1
EQ %btmp1 %in 1
Not %btmp1 %btmp1
branch if_end %btmp1
return %in
branch else_end true
label if_end
@var %itmp2
Sub %itmp2 %in 1
@var %itmp3
call %itmp3 %ifactorial ( %itmp2 )
Mul %itmp3 %itmp3 %in
return %itmp3
label else_end
@endfunc

@func main ( )
@var %in
@var %iresult
call %in get_int ( )
@var %btmp4
GT %btmp4 %in 1
Not %btmp4 %btmp4
branch if_end %btmp4
call %iresult %ifactorial ( %in )
branch else_end true
label if_end
assign %iresult 1
label else_end
call void print_int ( %iresult )
return 0
@endfunc 