int a = 1;
int b = 2;
int func1() {
  a = a + 1;
  return a;
}
int func2() {
  b = b + 2;
  return b;
}
int func3() {
  a = a + 3;
  b = b + 4;
  return a + b;
}
int func4() {
  a = a + b;
  return a + b;
}
int func5() {
  return a + b;
}
int main() {
  int a = 7;
  int c = 1;
  if  (     (     a == 7 
              ||  func2() == 0 /* skip */
            ) 
        &&  (     (     c == 0 
                    &&  func1() == 2 /* skip */
                  ) 
              ||  (     func3() == 10 /* exec */
                    ||  func4() == 5 /* skip */
                  )
            )
      ) 
  {
    a = a + b + func5();
  }
  return a + c; // 24
}
